# Signalpost OSINT Agent - Environment Configuration
# Copy this file to .env and fill in values. Never commit real keys to git!

# System Execution Mode ("lite" requires no external databases; "full" uses MongoDB)
MODE=lite

# Concurrency & Async Workers (1 to 8 workers)
WORKERS=8

# Budget Governor Request Caps
# Soft cap skips secondary pages; Brake halts all outbound network operations
SOFT_CAP_REQUESTS=1700
BRAKE_REQUESTS=1950
PER_COMPANY_CAP=14

# Language Model (Pass 2 Textual Extraction)
# Compatible with OpenAI, vLLM, Ollama, OpenRouter, or any OpenAI-compatible API
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_RPM=30

# Web Scraper & Network Timeout Limits
WEBSITE_TIMEOUT_S=8
WEBSITE_RETRIES=2
WEBSITE_MAX_PAGES=3
WEBSITE_TEXT_CHARS=6000

# Optional Fallbacks
PLAN_B_ENABLED=false
PLAYWRIGHT_ENABLED=false

# Deterministic Validation & Publication Thresholds
CONF_THRESHOLD=0.80
Q_THRESHOLD=0.95
IDENTITY_THRESHOLD=0.6

# Storage Locations
STORE_MODE=jsonl
DATA_DIR=data
OUTPUT_DIR=output
